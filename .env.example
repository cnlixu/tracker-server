# Copy this file to .env and replace change_me locally or on the server.
# Never commit the real .env file.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tracker
DB_USER=tracker
DB_PASSWORD=change_me
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_CONNECT_TIMEOUT=10
DB_COMMAND_TIMEOUT=30

# Production listens on 0.0.0.0:8686. Override TCP_HOST for local-only tests.
TCP_HOST=0.0.0.0
TCP_PORT=8686
TCP_READ_TIMEOUT_SECONDS=600

ONLINE_STATUS_ONLINE_MINUTES=20
ONLINE_STATUS_WARNING_MINUTES=60

# Generate the hash and secret with scripts/generate_admin_credentials.py.
# Never put the plain administrator password in this file.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=generate_with_scripts_generate_admin_credentials_py
SESSION_SECRET=generate_with_scripts_generate_admin_credentials_py
AUTH_SESSION_MAX_AGE_SECONDS=28800
# Set true only after HTTPS is configured; Secure cookies do not work over HTTP.
AUTH_COOKIE_SECURE=false
